# Discord MultiBot — .env.example
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ── Bot Core ──────────────────────────────────────────────────────────────────
# IMPORTANT: You MUST enable all 3 Privileged Intents (Presence, Server Members, Message Content)
# in the Discord Developer Portal for this bot to function correctly.
DISCORD_TOKEN=your_bot_token_here
PREFIX=!
GAME_PREFIX=owo

# Bot Owner Discord user ID (for owner-only commands)
BOT_OWNER_ID=

# ── Optional Features ─────────────────────────────────────────────────────────

# Get a free API key at https://home.openweathermap.org/api_keys
WEATHER_API_KEY=

# Get a free YouTube Data API v3 key from Google Cloud Console
YT_API_KEY=

# YouTube Cookies file path (e.g. cookies.txt) to bypass yt-dlp bot protection
YT_COOKIES=

# Coin flip animation GIF URL
COINFLIP_GIF=https://cdn.dribbble.com/userupload/20764551/file/original-ec7c7b25323fea450739f13b38db735f.gif

# Set to true to change verified users' nicknames to their in-game name
CHANGE_NICKNAME=false

# Extra role ID to include in lock/unlock commands (leave blank to disable)
EXTRA_ROLES_LOCK_UNLOCK=

# ── FiveM Verification ────────────────────────────────────────────────────────
VERIFICATION_FIVEM=false
# Your FiveM server address e.g. 123.45.67.89:30120
FIVEM_SERVER=
# Discord Role ID to assign after FiveM verification
FIVEM_ROLE_ID=
# Set to true to require the player's Discord ID to match in-game
FIVEM_VERIFICATION_DISCORD_REQUIRED=false

# ── Roblox Verification ───────────────────────────────────────────────────────
VERIFICATION_ROBLOX=false
ROBLOX_ROLE_ID=

# ── SA:MP Verification ────────────────────────────────────────────────────────
VERIFICATION_SAMP=false
SAMP_SERVER_IP=
SAMP_SERVER_PORT=
SAMP_ROLE_ID=

# Type of verification: "mysql", "rcon", or "basic"
SAMP_VERIF_TYPE=basic

# --- If SAMP_VERIF_TYPE is "mysql" ---
SAMP_DB_HOST=localhost
SAMP_DB_USER=root
SAMP_DB_PASSWORD=
SAMP_DB_NAME=samp_server
SAMP_DB_TABLE=players
SAMP_DB_COL_USERNAME=name
SAMP_DB_COL_VERIFY_CODE=verify_code
SAMP_DB_COL_DISCORD_ID=discord_id

# --- If SAMP_VERIF_TYPE is "rcon" ---
SAMP_RCON_PASSWORD=
# Format for the RCON command. Use {player} for the target and {code} for the verification code.
SAMP_RCON_CMD_FORMAT=pm {player} Your verification code is {code}

# ── Valorant Verification ─────────────────────────────────────────────────────
# Note: Currently under maintenance
VERIFICATION_VALO=false
# Get your Riot API key at https://developer.riotgames.com/
RIOT_API_KEY=
VALORANT_ROLE_ID=
